# --- Database (Postgres: Supabase, Neon, or local) ---
DATABASE_URL="postgresql://user:password@host:5432/receipts?sslmode=require"
# Optional direct (non-pooled) URL for migrations when using a pooler (Supabase/Neon)
DIRECT_URL="postgresql://user:password@host:5432/receipts?sslmode=require"

# --- App ---
# The domain shown inside the sign-in message. Must match the host users see in the browser.
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Random 32+ char secret used to hash session tokens
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Admin ---
# Comma-separated Solana wallet addresses allowed into /admin
ADMIN_WALLETS="YourAdminWalletAddressHere,AnotherAdminWallet"

# --- Cron ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/resolve
CRON_SECRET="change-me-too"

# --- Price feeds (all optional; public endpoints work without keys) ---
COINGECKO_API_KEY=""
# Set to "1" to use pro-api.coingecko.com with the key above
COINGECKO_PRO=""
